{
  "schema_version": 1,
  "note": "The property ladder (D-099): how homes are rented and bought. Terms live here and not in the district files, so a datapack can retune a price without rebuilding a street. The geometry of a home (where it is, what is in it) comes from the district's `residence` operation; this file says what it costs and what it allows. scripts/economy_model.py reads this same file.",
  "rules": {
    "cycle_minutes": 60,
    "prepay_max_cycles": 6,
    "grace_cycles": 2,
    "notice_cycles": 1,
    "deposit_cycles": 2,
    "sell_back_percent": 60,
    "welcome_motel_cycles": 2,
    "retrieval": "A lapsed home is never emptied, re-let or deleted: its tenant keeps the door and every container, loses only the comfort of the home (building and workstations) until the arrears are paid, and may move out at any time.",
    "city_price_factor": {
      "ironhaven": 1.15,
      "valewood": 0.9,
      "blackwater": 1.0
    },
    "city_price_note": "Applied to rent, deposit and purchase price at the moment of signing, by the city circle that contains the home (CityRegions); a home outside every circle, like the development Row, costs the listed price. Location only moves the price; it never changes what a home allows.",
    "upgrades_owners_only": true
  },
